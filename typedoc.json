{
  "entryPoints": ["./lib/sources/**/*.ts"],
  "entryPointStrategy": "expand",
  "out": "./docs/api",
  "tsconfig": "./tsconfig.json",
  "name": "next-three API",
  "readme": "none",
  "exclude": ["**/*.d.ts", "**/node_modules/**"],
  "plugin": ["typedoc-plugin-markdown"],
  "sort": ["source-order"],
  "useTsLinkResolution": true
}
