# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist/
/artifacts/
/docs/

# misc
.DS_Store
*.pem
*.zip
*.rar
/plaintext

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local caches and large unused assets
/.tmp/
/lib/.rollup-tmp/
/public/json/
/public/models/box.glb

# 库构建产物（由 npm run build:lib 生成，不纳入版本管理）
/lib/dist/

# 诊断脚本的落盘日志（调试中间产物）
/.*.log
/scripts/.*

# 智能体工作区状态与记忆
/.workbuddy/
